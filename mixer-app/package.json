{
  "name": "audiomixpult-control",
  "version": "1.0.0",
  "description": "Modern UI for Arduino Audio Mixer Control",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "audio",
    "mixer",
    "arduino",
    "deej",
    "volume-control"
  ],
  "author": "JonasGrafKWR",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "com.jonasgrafkwr.audiomixpult",
    "productName": "Audiomixpult Control",
    "npmRebuild": false,
    "copyright": "Copyright © 2025 JonasGrafKWR",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "publisherName": "JonasGrafKWR",
      "verifyUpdateCodeSignature": false,
      "sign": null,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Audiomixpult Control",
      "license": "../LICENSE",
      "runAfterFinish": true,
      "menuCategory": true,
      "deleteAppDataOnUninstall": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "assets/audio-helper.ps1"
    ],
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.md",
      "!.git",
      "!test/**",
      "!assets/nircmd*.exe",
      "!assets/NirCmd.chm"
    ]
  }
}
