{
  "name": "audiomixpult-control",
  "version": "1.0.0",
  "description": "Modern UI for Arduino Audio Mixer Control",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "audio",
    "mixer",
    "arduino",
    "deej",
    "volume-control"
  ],
  "author": "JonasGrafKWR",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0"
  },
  "build": {
    "appId": "com.jonasgrafkwr.audiomixpult",
    "productName": "Audiomixpult Control",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.md",
      "!.git"
    ]
  }
}
